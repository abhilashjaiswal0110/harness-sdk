# Copy to .env and fill in. .env is git-ignored.

# Anthropic API key, used by every anthropic/* model.
ANTHROPIC_API_KEY=

# Model the UI selects by default: "provider/name".
# Fully local, no API key: install Ollama, `ollama pull qwen3`, then use ollama/qwen3.
HARNESS_MODEL=anthropic/claude-sonnet-5-5

# Directory the agent works in (its shell, file tools, sessions and memory live here).
# Defaults to ./workspace next to this file.
# HARNESS_WORKSPACE=

# Tool approval: "ask" prompts in the UI before any tool that can change things; "off" runs all tools freely.
# HARNESS_APPROVAL=ask

# Server address. Keep 127.0.0.1: the agent has a shell, so never expose this on a network.
# PORT=3000
# HOST=127.0.0.1

# Ollama endpoint, if not the default http://127.0.0.1:11434.
# OLLAMA_HOST=
